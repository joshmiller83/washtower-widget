# Deploy settings for the WashTower relay. Copy to deploy/config.env (git-ignored)
# and adjust for your Mac. Every script in deploy/ reads this file.

# The macOS account the relay runs as. It owns the data folder and can read the ThinQ token.
SERVICE_USER=jm

# launchd label: <prefix>.washtower-relay
LABEL_PREFIX=com.example

# Where the relay keeps its binary, state.json, relay key and logs.
DATA_DIR=/Users/jm/WashTowerRelay

# The relay only listens on this Mac. Cloudflare Tunnel brings the phone's traffic in.
HOST=127.0.0.1
PORT=8792

# The public name the phone talks to.
PUBLIC_HOSTNAME=washtower.example.com

# LG ThinQ Connect personal access token (https://connect-pat.lgthinq.com), in a
# mode-600 file the service user can read, and the account's country code.
THINQ_TOKEN_FILE=/Users/jm/.config/thinq/pat
COUNTRY=US

# Push. An APNs auth key from developer.apple.com > Certificates, IDs & Profiles >
# Keys (Apple Push Notifications service), saved as a mode-600 file the service user
# can read, plus its Key ID and your Team ID. Leave empty until then: the relay runs
# without push, and the state API still works.
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
# The iPhone app's bundle id (pushes go to <bundle id>.push-type.liveactivity).
APNS_BUNDLE_ID=com.joshmiller83.WashTower
# "development" while the app is installed from Xcode; "production" for TestFlight.
APNS_ENV=development

# How long a finished Live Activity stays on the Lock Screen.
DISMISS_AFTER_MINUTES=60

# Cloudflare Tunnel (only tunnel-add-hostname.sh uses these).
CLOUDFLARED_BIN=/usr/local/bin/cloudflared
# The tunnel's config.yml. This setup adds an ingress rule to an existing tunnel.
CF_CONFIG=/Users/jm/.cloudflared/config.yml
# Tunnel name or id.
CF_TUNNEL=my-tunnel
# launchd label of the daemon that runs cloudflared, so we can print its restart command.
CF_LABEL=com.example.cloudflared
